# Copy to deploy/.env (git-ignored) and edit. Every value shown is the default.

# Address the port is published on. 127.0.0.1 = this machine only.
# Set it to the Tailscale IP (tailscale ip -4) to let your other devices in.
HCPD_BIND=127.0.0.1
# Port on the host (the container always listens on 47830 inside).
HCPD_PORT=47830

# Server limits (see docs/server.md).
HCPD_MAX_CONNS=200
HCPD_MAX_CONNS_PER_IP=10
HCPD_RATE_PER_S=20
HCPD_RATE_BURST=40
HCPD_CONNECTS_PER_MIN=60

# Container memory limit and backup schedule (every N seconds, keep N files).
HCPD_MEM_LIMIT=256m
HCPD_BACKUP_EVERY_S=86400
HCPD_BACKUP_KEEP=7

# Docker names. Change them only to run a second copy side by side (tests).
HCPD_CONTAINER=hcpd-server
HCPD_BACKUP_CONTAINER=hcpd-backup
HCPD_DATA_VOLUME=hcpd-data
HCPD_CERTS_VOLUME=hcpd-certs
HCPD_BACKUPS_VOLUME=hcpd-backups
